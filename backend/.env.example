# Copy to backend/.env and fill in. Never commit the real .env.

# DB
db_host=localhost
db_port=5432
db_name=
db_user=
db_password=

# Admin API secret – protects secret-header /admin/* endpoints
ADMIN_SECRET_KEY=

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
ADMIN_CLERK_USER_ID=
BLOCKED_CLERK_USER_IDS=

# FAISS index
FAISS_INDEX_DIR=
FAISS_INDEX_BIOARCHIVE_DIR=

# Mail digest (Resend)
RESEND_API_KEY=
DIGEST_FROM=
FRONTEND_URL=
# Optional: comma-separated emails that always get the digest
DIGEST_ALWAYS_SEND_TO=
# Optional: "true" enables GET /mail-digests/preview (keep off in production)
ENABLE_DIGEST_PREVIEW=

# Zotero OAuth (https://www.zotero.org/oauth/apps)
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=

# GEO API (POE) – server-side only
GEO_API_BASE_URL=
GEO_API_USERNAME=
GEO_API_PASSWORD=
