# Copy to .env.development / .env.production and fill in.
# NOTE: every VITE_* value is compiled into the public JS bundle — never put secrets here.

# Backend API URL (dev: http://localhost:8013, prod: /api)
VITE_API_URL=http://localhost:8013

# Clerk publishable key (pk_test_... for dev, pk_live_... for prod)
VITE_CLERK_PUBLISHABLE_KEY=

# Google Analytics Measurement ID (optional)
VITE_GA_MEASUREMENT_ID=

# Clerk user ID of the admin
VITE_ADMIN_CLERK_USER_ID=

# Comma-separated Clerk user IDs blocked from the platform
VITE_BLOCKED_CLERK_USER_IDS=
